+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package android.view;
+
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.Parcelable;
+import android.os.RemoteException;
+import android.window.PictureInPictureSurfaceTransaction;
+import android.window.TaskSnapshot;
+import android.window.WindowAnimationState;
+
+import com.android.internal.os.IResultReceiver;
+
+/**
+ * Client-side shim for the recents-animation controller interface.
+ *
+ * <p>This is the counterpart to {@link IRecentsAnimationRunner}: MuMu 15's
+ * {@code framework.jar} has no {@code android.view.IRecentsAnimationController}
+ * because the platform moved it to {@code com.android.wm.shell.recents}. The
+ * class keeps the AOSP 15 name so the rest of the project links unchanged, and
+ * reports the newer name in {@link #DESCRIPTOR} so the binder call is accepted
+ * by MuMu's SystemUI.
+ *
+ * <p>The launcher is the client here, so only {@code Stub.Proxy} really runs;
+ * {@code Stub} exists because {@code RecentsTransitionHandler} (compiled into
+ * this APK from the wmshell sources) derives from it.
+ */
+public interface IRecentsAnimationController extends IInterface {
+
+    /** The binder interface name MuMu's SystemUI uses. */
+    String DESCRIPTOR = "com.android.wm.shell.recents.IRecentsAnimationController";
+
+    TaskSnapshot screenshotTask(int taskId) throws RemoteException;
+
+    void setFinishTaskTransaction(int taskId,
+            PictureInPictureSurfaceTransaction finishTransaction,
+            SurfaceControl leash) throws RemoteException;
+
+    void finish(boolean moveHomeToFront, boolean sendUserLeaveHint,
+            IResultReceiver finishReceiver) throws RemoteException;
+
+    void setInputConsumerEnabled(boolean enabled) throws RemoteException;
+
+    void setAnimationTargetsBehindSystemBars(boolean behindSystemBars)
+            throws RemoteException;
+
+    void cleanupScreenshot() throws RemoteException;
+
+    void setDeferCancelUntilNextTransition(boolean defer, boolean screenshot)
+            throws RemoteException;
+
+    void setWillFinishToHome(boolean willFinishToHome) throws RemoteException;
+
+    boolean removeTask(int taskId) throws RemoteException;
+
+    void detachNavigationBarFromApp(boolean moveHomeToFront) throws RemoteException;
+
+    void animateNavigationBarToApp(long duration) throws RemoteException;
+
+    void handOffAnimation(RemoteAnimationTarget[] appTargets,
+            WindowAnimationState[] states) throws RemoteException;
+
+    abstract class Stub extends Binder implements IRecentsAnimationController {
+
+        // Transaction numbers as MuMu's SystemUI implements them. The platform
+        // this image runs on numbers only seven of the twelve methods above;
+        // the rest have no transaction at all and are answered locally by the
+        // proxy (see Proxy below), which is why there are no constants for
+        // them. Using AOSP 15's 1..12 numbering here would silently address the
+        // wrong methods on the other side.
+        static final int TRANSACTION_screenshotTask = 1;
+        static final int TRANSACTION_setFinishTaskTransaction = 2;
+        static final int TRANSACTION_finish = 3;
+        static final int TRANSACTION_setInputConsumerEnabled = 4;
+        static final int TRANSACTION_setWillFinishToHome = 5;
+        static final int TRANSACTION_detachNavigationBarFromApp = 6;
+        static final int TRANSACTION_handOffAnimation = 7;
+
+        public Stub() {
+            attachInterface(this, DESCRIPTOR);
+        }
+
+        public static IRecentsAnimationController asInterface(IBinder obj) {
+            if (obj == null) {
+                return null;
+            }
+            IInterface local = obj.queryLocalInterface(DESCRIPTOR);
+            if (local instanceof IRecentsAnimationController) {
+                return (IRecentsAnimationController) local;
+            }
+            return new Proxy(obj);
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return this;
+        }
+
+        @Override
+        public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            switch (code) {
+                case INTERFACE_TRANSACTION: {
+                    reply.writeString(DESCRIPTOR);
+                    return true;
+                }
+                case TRANSACTION_screenshotTask: {
+                    data.enforceInterface(DESCRIPTOR);
+                    int taskId = data.readInt();
+                    data.enforceNoDataAvail();
+                    TaskSnapshot result = screenshotTask(taskId);
+                    reply.writeNoException();
+                    reply.writeTypedObject(result, Parcelable.PARCELABLE_WRITE_RETURN_VALUE);
+                    return true;
+                }
+                case TRANSACTION_setFinishTaskTransaction: {
+                    data.enforceInterface(DESCRIPTOR);
+                    int taskId = data.readInt();
+                    PictureInPictureSurfaceTransaction finishTransaction =
+                            data.readTypedObject(PictureInPictureSurfaceTransaction.CREATOR);
+                    SurfaceControl leash = data.readTypedObject(SurfaceControl.CREATOR);
+                    data.enforceNoDataAvail();
+                    setFinishTaskTransaction(taskId, finishTransaction, leash);
+                    reply.writeNoException();
+                    return true;
+                }
+                case TRANSACTION_finish: {
+                    data.enforceInterface(DESCRIPTOR);
+                    boolean moveHomeToFront = data.readBoolean();
+                    boolean sendUserLeaveHint = data.readBoolean();
+                    IResultReceiver finishReceiver =
+                            IResultReceiver.Stub.asInterface(data.readStrongBinder());
+                    data.enforceNoDataAvail();
+                    finish(moveHomeToFront, sendUserLeaveHint, finishReceiver);
+                    reply.writeNoException();
+                    return true;
+                }
+                case TRANSACTION_setInputConsumerEnabled: {
+                    data.enforceInterface(DESCRIPTOR);
+                    boolean enabled = data.readBoolean();
+                    data.enforceNoDataAvail();
+                    setInputConsumerEnabled(enabled);
+                    reply.writeNoException();
+                    return true;
+                }
+                case TRANSACTION_setWillFinishToHome: {
+                    data.enforceInterface(DESCRIPTOR);
+                    boolean willFinishToHome = data.readBoolean();
+                    data.enforceNoDataAvail();
+                    setWillFinishToHome(willFinishToHome);
+                    reply.writeNoException();
+                    return true;
+                }
+                case TRANSACTION_detachNavigationBarFromApp: {
+                    data.enforceInterface(DESCRIPTOR);
+                    boolean moveHomeToFront = data.readBoolean();
+                    data.enforceNoDataAvail();
+                    detachNavigationBarFromApp(moveHomeToFront);
+                    reply.writeNoException();
+                    return true;
+                }
+                case TRANSACTION_handOffAnimation: {
+                    data.enforceInterface(DESCRIPTOR);
+                    RemoteAnimationTarget[] appTargets =
+                            data.createTypedArray(RemoteAnimationTarget.CREATOR);
+                    WindowAnimationState[] states =
+                            data.createTypedArray(WindowAnimationState.CREATOR);
+                    data.enforceNoDataAvail();
+                    handOffAnimation(appTargets, states);
+                    reply.writeNoException();
+                    return true;
+                }
+                default:
+                    return super.onTransact(code, data, reply, flags);
+            }
+        }
+
+        private static final class Proxy implements IRecentsAnimationController {
+
+            private final IBinder mRemote;
+
+            Proxy(IBinder remote) {
+                mRemote = remote;
+            }
+
+            @Override
+            public IBinder asBinder() {
+                return mRemote;
+            }
+
+            public String getInterfaceDescriptor() {
+                return DESCRIPTOR;
+            }
+
+            @Override
+            public TaskSnapshot screenshotTask(int taskId) throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                TaskSnapshot result;
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeInt(taskId);
+                    mRemote.transact(TRANSACTION_screenshotTask, data, reply, 0);
+                    reply.readException();
+                    result = reply.readTypedObject(TaskSnapshot.CREATOR);
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+                return result;
+            }
+
+            @Override
+            public void setFinishTaskTransaction(int taskId,
+                    PictureInPictureSurfaceTransaction finishTransaction,
+                    SurfaceControl leash) throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeInt(taskId);
+                    data.writeTypedObject(finishTransaction, 0);
+                    data.writeTypedObject(leash, 0);
+                    mRemote.transact(TRANSACTION_setFinishTaskTransaction, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void finish(boolean moveHomeToFront, boolean sendUserLeaveHint,
+                    IResultReceiver finishReceiver) throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeBoolean(moveHomeToFront);
+                    data.writeBoolean(sendUserLeaveHint);
+                    data.writeStrongInterface(finishReceiver);
+                    mRemote.transact(TRANSACTION_finish, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void setInputConsumerEnabled(boolean enabled) throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeBoolean(enabled);
+                    mRemote.transact(TRANSACTION_setInputConsumerEnabled, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void setWillFinishToHome(boolean willFinishToHome) throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeBoolean(willFinishToHome);
+                    mRemote.transact(TRANSACTION_setWillFinishToHome, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void detachNavigationBarFromApp(boolean moveHomeToFront)
+                    throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeBoolean(moveHomeToFront);
+                    mRemote.transact(TRANSACTION_detachNavigationBarFromApp, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void handOffAnimation(RemoteAnimationTarget[] appTargets,
+                    WindowAnimationState[] states) throws RemoteException {
+                Parcel data = Parcel.obtain();
+                Parcel reply = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeTypedArray(appTargets, 0);
+                    data.writeTypedArray(states, 0);
+                    mRemote.transact(TRANSACTION_handOffAnimation, data, reply, 0);
+                    reply.readException();
+                } finally {
+                    reply.recycle();
+                    data.recycle();
+                }
+            }
+
+            /*
+             * The four methods below have no transaction on this platform's
+             * SystemUI. They are answered locally rather than sent: a binder
+             * call to a code the server does not handle comes back without a
+             * reply, and the resulting failure surfaces as a broken gesture
+             * rather than as a logged no-op. `removeTask` reports failure for
+             * the same reason -- the task is not removed, and the caller
+             * already treats `false` as "try another route".
+             */
+
+            @Override
+            public void setAnimationTargetsBehindSystemBars(boolean behindSystemBars) {
+                // No-op: not implemented by MuMu's SystemUI.
+            }
+
+            @Override
+            public void cleanupScreenshot() {
+                // No-op: not implemented by MuMu's SystemUI.
+            }
+
+            @Override
+            public void setDeferCancelUntilNextTransition(boolean defer, boolean screenshot) {
+                // No-op: not implemented by MuMu's SystemUI.
+            }
+
+            @Override
+            public void animateNavigationBarToApp(long duration) {
+                // No-op: not implemented by MuMu's SystemUI.
+            }
+
+            @Override
+            public boolean removeTask(int taskId) {
+                return false;
+            }
+        }
+    }
+}
