+ * limitations under the License.
+ */
+
+package android.view;
+
+import android.graphics.Rect;
+import android.os.Binder;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.window.TaskSnapshot;
+
+/**
+ * Client-side shim for the recents-animation callback interface.
+ *
+ * <p>MuMu 15's {@code framework.jar} does not contain
+ * {@code android.view.IRecentsAnimationRunner} — the platform moved this AIDL to
+ * {@code com.android.wm.shell.recents} before that release. The class is
+ * nevertheless named here exactly as the AOSP 15 interface
+ * ({@code android.view.IRecentsAnimationRunner}) so that the rest of this
+ * project compiles and links against it unchanged, while {@link #DESCRIPTOR}
+ * carries the name MuMu's SystemUI actually puts on the wire.
+ *
+ * <p>Without this file the launcher's dex refers to
+ * {@code Landroid/view/IRecentsAnimationRunner$Stub;}, which resolves nowhere:
+ * not in the boot classpath (absent there) and not in the APK itself, because
+ * {@code framework-15.jar} is a {@code compileOnly} dependency. ART then throws
+ * {@code NoClassDefFoundError} while verifying
+ * {@code ActivityManagerCompatVV}, which kills {@code TouchInteractionService}
+ * during {@code onCreate} and leaves every APP_SWITCH inside a queued command
+ * that never completes.
+ *
+ * @see IRecentsAnimationController
+ */
+public interface IRecentsAnimationRunner extends IInterface {
+
+    /**
+     * The binder interface name MuMu's SystemUI uses. This is deliberately not
+     * {@code android.view.IRecentsAnimationRunner}: the platform on this image
+     * speaks the newer {@code com.android.wm.shell.recents} protocol.
+     */
+    String DESCRIPTOR = "com.android.wm.shell.recents.IRecentsAnimationRunner";
+
+    void onAnimationCanceled(int[] taskIds, TaskSnapshot[] taskSnapshots)
+            throws RemoteException;
+
+    void onAnimationStart(IRecentsAnimationController controller,
+            RemoteAnimationTarget[] appTargets, RemoteAnimationTarget[] wallpaperTargets,
+            Rect homeContentInsets, Rect minimizedHomeBounds, Bundle options)
+            throws RemoteException;
+
+    void onTasksAppeared(RemoteAnimationTarget[] appTargets) throws RemoteException;
+
+    /**
+     * Local-side implementation. The launcher is the server here: SystemUI
+     * calls these three methods back, and the transaction numbers below are
+     * taken from MuMu's own SystemUI rather than from AOSP 15 (which numbered
+     * the same methods 1, 2 and 3).
+     */
+    abstract class Stub extends Binder implements IRecentsAnimationRunner {
+
+        static final int TRANSACTION_onAnimationCanceled = 2;
+        static final int TRANSACTION_onAnimationStart = 3;
+        static final int TRANSACTION_onTasksAppeared = 4;
+
+        public Stub() {
+            attachInterface(this, DESCRIPTOR);
+        }
+
+        /**
+         * Turn a raw binder into the interface, without reflection: the caller
+         * is on the hot path of a gesture, and a {@code Class.forName} miss here
+         * would be indistinguishable from the class-resolution failure this
+         * file exists to prevent.
+         */
+        public static IRecentsAnimationRunner asInterface(IBinder obj) {
+            if (obj == null) {
+                return null;
+            }
+            IInterface local = obj.queryLocalInterface(DESCRIPTOR);
+            if (local instanceof IRecentsAnimationRunner) {
+                return (IRecentsAnimationRunner) local;
+            }
+            return new Proxy(obj);
+        }
+
+        @Override
+        public IBinder asBinder() {
+            return this;
+        }
+
+        @Override
+        public boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            switch (code) {
+                case INTERFACE_TRANSACTION: {
+                    reply.writeString(DESCRIPTOR);
+                    return true;
+                }
+                case TRANSACTION_onAnimationCanceled: {
+                    data.enforceInterface(DESCRIPTOR);
+                    int[] taskIds = data.createIntArray();
+                    TaskSnapshot[] taskSnapshots =
+                            data.createTypedArray(TaskSnapshot.CREATOR);
+                    data.enforceNoDataAvail();
+                    onAnimationCanceled(taskIds, taskSnapshots);
+                    reply.writeNoException();
+                    return true;
+                }
+                case TRANSACTION_onAnimationStart: {
+                    data.enforceInterface(DESCRIPTOR);
+                    IRecentsAnimationController controller =
+                            IRecentsAnimationController.Stub.asInterface(
+                                    data.readStrongBinder());
+                    RemoteAnimationTarget[] appTargets =
+                            data.createTypedArray(RemoteAnimationTarget.CREATOR);
+                    RemoteAnimationTarget[] wallpaperTargets =
+                            data.createTypedArray(RemoteAnimationTarget.CREATOR);
+                    Rect homeContentInsets = data.readTypedObject(Rect.CREATOR);
+                    Rect minimizedHomeBounds = data.readTypedObject(Rect.CREATOR);
+                    Bundle options = data.readTypedObject(Bundle.CREATOR);
+                    data.enforceNoDataAvail();
+                    onAnimationStart(controller, appTargets, wallpaperTargets,
+                            homeContentInsets, minimizedHomeBounds, options);
+                    reply.writeNoException();
+                    return true;
+                }
+                case TRANSACTION_onTasksAppeared: {
+                    data.enforceInterface(DESCRIPTOR);
+                    RemoteAnimationTarget[] appTargets =
+                            data.createTypedArray(RemoteAnimationTarget.CREATOR);
+                    data.enforceNoDataAvail();
+                    onTasksAppeared(appTargets);
+                    reply.writeNoException();
+                    return true;
+                }
+                default:
+                    return super.onTransact(code, data, reply, flags);
+            }
+        }
+
+        private static final class Proxy implements IRecentsAnimationRunner {
+
+            private final IBinder mRemote;
+
+            Proxy(IBinder remote) {
+                mRemote = remote;
+            }
+
+            @Override
+            public IBinder asBinder() {
+                return mRemote;
+            }
+
+            public String getInterfaceDescriptor() {
+                return DESCRIPTOR;
+            }
+
+            @Override
+            public void onAnimationCanceled(int[] taskIds, TaskSnapshot[] taskSnapshots)
+                    throws RemoteException {
+                Parcel data = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeIntArray(taskIds);
+                    data.writeTypedArray(taskSnapshots, 0);
+                    mRemote.transact(TRANSACTION_onAnimationCanceled, data, null,
+                            IBinder.FLAG_ONEWAY);
+                } finally {
+                    data.recycle();
+                }
+            }
+
+            @Override
+            public void onAnimationStart(IRecentsAnimationController controller,
+                    RemoteAnimationTarget[] appTargets,
+                    RemoteAnimationTarget[] wallpaperTargets,
+                    Rect homeContentInsets, Rect minimizedHomeBounds, Bundle options)
+                    throws RemoteException {
+                Parcel data = Parcel.obtain();
+                try {
+                    data.writeInterfaceToken(DESCRIPTOR);
+                    data.writeStrongInterface(controller);
+                    data.writeTypedArray(appTargets, 0);
+                    data.writeTypedArray(wallpaperTargets, 0);
+                    data.writeTypedObject(homeContentInsets, 0);
+                    data.writeTypedObject(minimizedHomeBounds, 0);
+                    data.writeTypedObject(options, 0);
